# 服务
PORT=3000
NODE_ENV=development

# PostgreSQL（与 docker-compose.yml 一致）
DATABASE_URL=postgresql://coffeelink:coffeelink_dev@localhost:5433/coffeelink?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# 认证
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d

# 短信 Provider（Mock 先行；SMS_MOCK_CODE 仅 Mock 使用）
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456
